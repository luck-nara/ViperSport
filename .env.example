# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Admin (hard-coded login)
ADMIN_USERNAME=viperadmin
ADMIN_PASSWORD=ViperSport2025!
POINTS_PER_PHONE=50

# --- Supabase PostgreSQL (เลือกวิธีใดวิธีหนึ่ง) ---

# วิธีที่ 1: Connection URI จาก Supabase Dashboard (แนะนำ)
# Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_SSLMODE=require

# วิธีที่ 2: แยกตัวแปร (comment DATABASE_URL แล้วใช้อันนี้)
# DB_HOST=db.xxxxxxxxxxxx.supabase.co
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_PORT=5432
# DB_SSLMODE=require

# ถ้าไม่ตั้ง DATABASE_URL และ DB_HOST จะใช้ SQLite ในเครื่อง
